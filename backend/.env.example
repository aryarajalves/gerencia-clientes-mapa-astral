# Configuração do Baserow (Banco de Dados)
BASEROW_API_URL=https://api.baserow.io
BASEROW_API_TOKEN=seu_token_baserow_aqui
BASEROW_TABLE_ID=12345
BASEROW_TABLE_ID_INFO=67890

# Configuração do Chatwoot
CHATWOOT_API_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=seu_token_chatwoot_aqui
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=123
CHATWOOT_MESSAGE_DELAY=3

# Automação N8N (Webhook para gerar PDF)
N8N_WEBHOOK_GERAR_MAPA_URL=https://n8n.exemplo.com/webhook/gerar-mapa

# WhatsApp API Oficial (Meta)
WHATSAPP_API_TOKEN=seu_token_whatsapp_aqui
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321

# Cache Redis
# Formato: redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Monitoramento de Erros (Sentry)
SENTRY_DSN=https://sua_chave_publica@o0.ingest.sentry.io/0
